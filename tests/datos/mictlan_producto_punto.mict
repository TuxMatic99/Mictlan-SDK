
# Mictlan Ciencia: prueba del producto punto.

escribir("=== PRODUCTO PUNTO ===")

# Dos vectores conocidos.
resultado = ciencia.producto_punto2(3, 4, 5, 12)

escribir("Producto punto de (3,4) y (5,12):")
