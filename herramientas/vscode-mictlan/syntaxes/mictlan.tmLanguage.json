{
  "name": "Mictlán (alfa)",
  "scopeName": "source.mictlan",
  "patterns": [
    {
      "name": "comment.line.number-sign.mictlan",
      "match": "#.*$"
    },
    {
      "name": "comment.line.double-slash.mictlan",
      "match": "//.*$"
    },
    {
      "name": "comment.block.mictlan",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "string.quoted.double.mictlan",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mictlan",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.mictlan",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.mictlan",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.mictlan",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    },
    {
      "name": "constant.language.mictlan",
      "match": "\\b(?:verdadero|cierto|falso|nulo)\\b"
    },
    {
      "name": "keyword.control.mictlan",
      "match": "\\b(?:si|osi|sino|fin|elegir|caso|otro|defecto|mientras|repetir|hasta|desde|para|en|rango|romper|continuar|funcion|fun|retorno|retornar|regresar|devolver|ret|global|ir|clase|constructor|hereda|super|mi|estatico|nueva)\\b"
    },
    {
      "name": "support.function.mictlan",
      "match": "\\b(?:escribir|poner|imprimir|imprimirf|incluir|error|tipo|anumero|acadena|alogico|leer)\\b(?=\\s*\\()"
    },
    {
      "name": "entity.name.type.module.mictlan",
      "match": "\\b(?:ciencia|graficos|ui)\\b(?=\\s*\\.)"
    }
  ]
}
