#!/usr/bin/env bash
set -euo pipefail
if [[ $# != 0 ]]; then
    echo 'Uso: probar-registro' >&2
    exit 3
fi
raiz=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
trabajo=$(mktemp -d "${TMPDIR:-/tmp}/registro-pruebas.XXXXXX")
limpiar() {
    rm -f -- "$trabajo/registro-prueba.txt"
    rmdir -- "$trabajo"
}
trap limpiar EXIT
cd "$trabajo"
"$raiz/bin/mictlan" -- "$raiz/Registro/pruebas/datos.mict"
